#############################################################################
# Imintty configuration template, with some useful examples -
# uncomment, change settings or add options to your preference.
# This sample config template mainly contains settings that 
# cannot be configured in the interactive Options dialog.
# The config file should best be placed in one of these locations:
#	$HOME/.iminttyrc
#	$HOME/.config/imintty/config
#	$APPDATA/imintty/config
#	(see manual for further options)

# enable a Compose key
#ComposeKey=ctrl

# cursor type: block (default), line, underscore
#CursorType=block

# animation modes: blink, smooth, phase, expand, solid
# cursor/text blink (solid = always on; blink = hard on/off; smooth = fade;
# phase = sine wave; expand = grow/shrink)
#SmoothBlinkCursor=smooth
#SmoothBlinkAttr=smooth
#SmoothBlinkBell=yes
#SmoothBlinkDuration=100

# cursor motion / scroll (smooth = animate; default/none = instant)
#SmoothCursor=smooth
#SmoothCursorDuration=50
#SmoothScroll=smooth
#SmoothScrollDuration=100
#SmoothScrollLines=8

# dynamic blur pulse during animation (ms; 0 = none)
#DynamicBlur=0

# enable a VT320 status line
#StatusLine=yes

# enable DECSET 3 column switching by default (also enabled by DECSET 40)
#Enable132ColumnSwitching=yes

# enable terminal reflow on resize (also configurable in Options)
#RewrapOnResize=yes

# enable the Kitty keyboard protocol (also configurable in Options)
#KittyKeyboard=yes

# enable single-dash long options, e.g. imintty -WSL
#ShortLongOpts=on

# enable wslbridge2 as a WSL launcher
#WSLbridge=2
# new default uses native wsl.exe launcher
#WSLbridge=0

# indicate image space in clipboard
#SixelClipChars=▒

# place image or HTML screenshot files in common location
#default SaveFilename=imintty.%Y-%m-%d_%H-%M-%S
#SaveFilename=~/imintty.%Y-%m-%d_%H-%M-%S
#SaveFilename=$USERPROFILE/Pictures/imintty/imintty.%Y-%m-%d_%H-%M-%S

# place terminal log files in common location
#default Log=imintty.$h.%Y-%m-%d_%H-%M-%S.$p.log
#Log=~/imintty.$h.%Y-%m-%d_%H-%M-%S.$p.log
#Log=/tmp/imintty.$h.%Y-%m-%d_%H-%M-%S.$p.log

# add some useful actions to the extended context menu
#CtxMenuFunctions=Reverse Video:toggle-reverse-video;\
	Status line:toggle-status-line;\
	BiDi:toggle-bidi;\
	Tab bar:toggle-tabbar;\
	ScrollLock:toggle-no-scroll;\
	Dim margins:toggle-dim-margins;\
	Opaque override:toggle-opaque;\
	Send Intr:intr;\
	New Window here:new-window-cwd;\
	Show config files:config-log;\
	Suspend screen saver:win-toggle-keep-screen-on;

# add session launchers to the extended context menu
#SessionCommands=WSL:--WSL;Debian:--WSL=Debian;Ubuntu:--WSL=Ubuntu;\
	Small Window:--size 60x20;PowerShell:-e powershell;

# define some useful keyboard functions and some examples of user-defined keys
#KeyFunctions=Break:break;\
	AW+Left:tab-left;AW+Right:tab-right;\
	AW+KP_Left:tab-left;AW+KP_Right:tab-right;\
	A+F12:'🤓';AC+F12:`echo -n $( date )`;

# DirectWrite OpenType features when FontRender=dwrite (comma-separated 4-char tags).
#FontFeatures=ss01,zero,calt

# load a Lua script after this config file (POSIX, Windows, or long paths).
# The script may use imintty.set / get / rc / on / command / key / expand_path.
#LuaConfig=~/.config/imintty/init.lua
#LuaConfig=C:\Users\me\.config\imintty\init.lua

#############################################################################
